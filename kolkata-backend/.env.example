# Kolkata Real Estate Backend - Environment Variables Template

# ============================================================
# DATABASE CONFIGURATION (Railway MySQL)
# ============================================================
MYSQL_HOST=your-railway-public-mysql-host.proxy.rlwy.net
MYSQL_PORT=your-railway-public-mysql-port
MYSQL_DATABASE=railway
MYSQL_USER=root
MYSQL_PASSWORD=your-railway-mysql-password

# ============================================================
# SECURITY & JWT
# ============================================================
JWT_SECRET=your-256-bit-base64-encoded-secret-key-minimum-43-chars

# ============================================================
# CORS & ORIGINS
# ============================================================
CORS_ORIGINS=https://kolkata-frontend.onrender.com,https://yourdomain.com

# ============================================================
# APPLICATION
# ============================================================
APP_URL=https://kolkata-backend.onrender.com/api
UPLOAD_DIR=/opt/render/project/uploads
SPRING_PROFILES_ACTIVE=prod

# ============================================================
# SERVER
# ============================================================
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
